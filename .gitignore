# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Saved songs stay on this computer only (they may contain copyrighted music).
# Ignore everything in saved_music except the placeholder that keeps the folder.
saved_music/*
!saved_music/.gitkeep
# Exported MIDI files and printed PDFs are songs too, wherever they're saved.
*.mid
*.pdf

# Songs chosen to share on GitHub, one line each, with why it's OK to share.
# The "!" un-ignores just that file; these lines must come after the rules above.
# Public domain (1814):
!saved_music/Star Spangled.mid

# SoundFonts are large binaries; download them separately
*.sf2
*.sf3

# Editors / OS
.vscode/
.idea/
Thumbs.db
